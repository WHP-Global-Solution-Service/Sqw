{
    "rules": {
        ".read": false,
        ".write": false,
        "markers": {
            "$uid": {
                ".read": "auth != null && auth.uid == $uid",
                ".write": "auth != null && auth.uid == $uid"
            }
        },
        "markersPublic": {
            ".read": true,
            ".write": "auth != null && root.child('roles').child(auth.uid).val() == 'admin'"
        },
        "eiaProjects": {
            "$uid": {
                ".read": "auth != null && auth.uid == $uid",
                ".write": "auth != null && auth.uid == $uid"
            }
        },
        "eiaProjectsPublic": {
            ".read": true,
            ".write": "auth != null && root.child('roles').child(auth.uid).val() == 'admin'"
        },
        "profiles": {
            "$uid": {
                ".read": true,
                ".write": "auth != null && auth.uid == $uid",
                "private": {
                    ".read": "auth != null && auth.uid == $uid",
                    ".write": "auth != null && auth.uid == $uid"
                }
            }
        },
        "presence": {
            "$uid": {
                ".read": true,
                ".write": "auth != null && auth.uid == $uid"
            }
        },
        "orders": {
            "$orderId": {
                ".read": "auth != null && (root.child('orders').child($orderId).child('owner').val() == auth.uid || root.child('roles').child(auth.uid).val() == 'admin')",
                ".write": "auth != null && (newData.child('owner').val() == auth.uid || root.child('roles').child(auth.uid).val() == 'admin')"
            }
        },
        "unlocks": {
            "$uid": {
                ".read": "auth != null && auth.uid == $uid",
                ".write": "auth != null && auth.uid == $uid"
            }
        },
        "privateChats": {
            "$uid": {
                "$otherUid": {
                    ".read": "auth != null && (auth.uid == $uid || auth.uid == $otherUid)",
                    ".write": "auth != null && (auth.uid == $uid || auth.uid == $otherUid)"
                }
            }
        },
        "chatRooms": {
            "$roomId": {
                ".read": "root.child('rooms').child($roomId).child('public').val() === true || (auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists())",
                ".write": "auth != null && root.child('rooms').child($roomId).child('members').child(auth.uid).exists()"
            }
        }
    }
}
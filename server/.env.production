# Environment Configuration for Production

# Server Configuration
PORT=3001
NODE_ENV=production

# ChillPay Payment Gateway Configuration
CHILLPAY_MERCHANT_CODE=M037016
CHILLPAY_API_KEY=your_production_api_key_here
CHILLPAY_MD5_SECRET=your_production_md5_secret_here

# API URL (Production)
CHILLPAY_API_URL=https://pgw.chillpay.co

# Mock Mode (set to false for production)
MOCK_MODE=false

# CORS Configuration
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database (if needed)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=sqw_db
# DB_USER=sqw_user
# DB_PASSWORD=your_db_password
